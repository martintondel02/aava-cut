{
  "name": "aava-cut",
  "version": "2.1.1",
  "private": true,
  "description": "Aava Cut \u2014 a local-first video editor for Linux with H.264/H.265/AV1, 10-bit HDR10, AMD Radeon acceleration and a live MCP agent bridge.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"node server/index.mjs\" \"vite --host 127.0.0.1\"",
    "server": "node server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node server/index.mjs --prod",
    "desktop": "npm run build && electron .",
    "desktop:start": "electron .",
    "desktop:dev": "concurrently -k -n server,web,app -c cyan,magenta,yellow \"node server/index.mjs\" \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "test:e2e": "playwright test",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb rpm --publish never",
    "dist:dir": "npm run build && electron-builder --linux dir --publish never",
    "fetch:yt-dlp": "node scripts/fetch-yt-dlp.mjs",
    "predist:linux": "npm run fetch:yt-dlp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.1.0",
    "immer": "^11.2.9",
    "lucide-react": "^0.545.0",
    "multer": "^2.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.7.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "concurrently": "^9.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "dev.aava.cut",
    "productName": "Aava Cut",
    "copyright": "Copyright \u00a9 2026 Aava",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "artifactName": "Aava-Cut-${version}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "server/**/*",
      "electron/**/*",
      "public/fonts/**/*",
      "public/icon.png",
      "public/favicon.svg",
      "package.json",
      "README.md",
      "LICENSE",
      "shared/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "AudioVideo",
      "icon": "public/icon.png",
      "executableName": "aava-cut",
      "synopsis": "Aava Cut \u2014 local-first video editing with AMD acceleration and 10-bit HDR",
      "description": "Aava Cut is the first product from Aava: a local-first, multi-track video editor for Linux with spring keyframes, captions, effects, audio EQ, AMD VAAPI hardware encoding, H.264/H.265/AV1 and 10-bit HDR10 delivery.",
      "syncDesktopName": true
    },
    "deb": {
      "depends": [
        "ffmpeg",
        "libvulkan1"
      ]
    },
    "rpm": {
      "depends": [
        "/usr/bin/ffmpeg",
        "vulkan-loader"
      ]
    },
    "extraResources": [
      {
        "from": "vendor/yt-dlp",
        "to": "bin",
        "filter": [
          "yt-dlp"
        ]
      }
    ]
  },
  "author": {
    "name": "Martin T\u00f8ndel",
    "email": "martintondel02@users.noreply.github.com"
  },
  "homepage": "https://aava.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martintondel02/aava-cut.git"
  },
  "bugs": {
    "url": "https://github.com/martintondel02/aava-cut/issues"
  },
  "license": "MIT",
  "keywords": [
    "video-editor",
    "linux",
    "electron",
    "react",
    "ffmpeg",
    "capcut",
    "keyframes",
    "local-first"
  ],
  "desktopName": "aava-cut.desktop"
}
