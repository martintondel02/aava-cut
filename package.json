{
  "name": "lumacut",
  "version": "1.0.0",
  "private": true,
  "description": "LumaCut — a full-featured, local-first video editor for Linux",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"node server/index.mjs\" \"vite --host 127.0.0.1\"",
    "server": "node server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node server/index.mjs --prod",
    "desktop": "npm run build && electron .",
    "desktop:start": "electron .",
    "desktop:dev": "concurrently -k -n server,web,app -c cyan,magenta,yellow \"node server/index.mjs\" \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "setup:demo": "node scripts/generate-demo.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "express": "^5.1.0",
    "immer": "^10.1.1",
    "lucide-react": "^0.545.0",
    "multer": "^2.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.7.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "concurrently": "^9.2.1",
    "electron": "^38.2.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "wait-on": "^9.0.1"
  }
}
